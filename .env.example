# ============================================================
# Supabase Project Credentials
# Copy this file to .env.local and fill in the values.
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# ============================================================

# Public Supabase URL (from API Settings page)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# Public anon key (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase service_role key (SECRET — server-side only, DO NOT expose to client)
# Get from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ============================================================
# Supabase CLI — used only for local development
# ============================================================

# Optional: override the default DB connection URL for `supabase db pull/push`
# You usually do NOT need this if using `supabase link`.
SUPABASE_DB_URL=

# Supabase project ref (the 12-char slug in your project URL)
# Used by `npm run link`. Example: abcd1234efgh5678
SUPABASE_PROJECT_REF=

# ============================================================
# App (optional)
# ============================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
