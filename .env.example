# ============================================================
# Resend.com за испраќање нарачки по е-пошта
# ============================================================

# Земи бесплатен API клуч овде: https://resend.com/api-keys
# 3000 е-пошти месечно БЕСПЛАТНО — повеќе од доволно за локална ресторан.
RESEND_API_KEY=

# Адреса на испраќач (верифициран испраќач во Resend).  Мора да е домен
# кој го поседувате или користете вграден Resend тест испраќач.
# Пример: "naracki@vucko-rostuse.mk"
RESEND_FROM_EMAIL=

# Е-пошта на која се испраќаат сите нови нарачки.
# Стандардно: ahmedidelil0@gmail.com
ORDER_RECEIVER_EMAIL=ahmedidelil0@gmail.com

# ============================================================
# Опционално: Admin лозинка за подесувања
# ============================================================
#
# Поставете ја ова на било која јака лозинка.
# Ако е празна, опциите за отварање/затворање на нарачки
# преку API се оневозможени.
ADMIN_PASSWORD=

# ============================================================
# App
# ============================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
